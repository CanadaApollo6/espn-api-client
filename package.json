{
  "name": "espn-api-client",
  "version": "0.1.0",
  "description": "A small, type-safe TypeScript client for ESPN's unofficial public APIs.",
  "keywords": [
    "espn",
    "sports",
    "api",
    "typescript",
    "nfl",
    "nba",
    "mlb",
    "nhl"
  ],
  "homepage": "https://github.com/CanadaApollo6/espn-api-client#readme",
  "bugs": {
    "url": "https://github.com/CanadaApollo6/espn-api-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanadaApollo6/espn-api-client.git"
  },
  "license": "MIT",
  "author": "Riel St. Amand",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run check:biome && npm run typecheck && npm test && npm run build && npm run test:package && npm run publint",
    "check:biome": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "cross-env ESPN_LIVE_TESTS=1 vitest run tests/live",
    "test:package": "node scripts/package-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run check"
  },
  "dependencies": {
    "ky": "^2.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}
